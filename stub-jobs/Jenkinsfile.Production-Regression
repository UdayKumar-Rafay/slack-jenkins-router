#! /usr/bin/env groovy
import groovy.json.JsonSlurper

def email_address = 'automation@rafay.co,ops@rafay.co,qa@rafay.co,abhiraman@rafay.co,saira@rafay.co,utkarsh@rafay.co,deepak@rafay.co'

properties([
parameters([
    string(name: 'test_purpose', defaultValue: 'Prod Regression Run', description: 'Mention the purpose of run [1.12.x Release regression preview run]'),
    listGitBranches(branchFilter: 'refs/heads/(master|v.*.x$)',defaultValue: 'master',name: 'rauto_branch',type: 'BRANCH',remoteURL: 'https://github.com/RafaySystems/rauto.git',credentialsId: "githubcredentials",selectedValue: "DEFAULT",description: 'Select rauto branch',sortMode: "ASCENDING"),
    string(name: 'rauto_buildnum', defaultValue: '', description: 'rauto image build used for testing'),
    extendedChoice(name: 'squad_name', value: 'all,blue,green,pelicians,vikings,avengers,alpha,mavericks,common,labs-paas', defaultValue: 'all', description: 'Select squad: blue:[placement,opa],green:[gitops,ztka,rbac],pelicians:[cost],vikings:[eks],avengers:[mks],alpha:[aks],mavericks:[gke]', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_SINGLE_SELECT', visibleItemCount: 1),
    [$class: 'CascadeChoiceParameter',
        choiceType: 'PT_MULTI_SELECT',
        description: 'Select rauto tags',
        name: 'features',
        referencedParameters: 'rauto_branch,squad_name',
        script: [
            $class: 'GroovyScript',
            fallbackScript: [
                classpath: [],
                script:
                '''
                    import groovy.json.JsonSlurper
                    def json = new JsonSlurper().parseText( new URL( 'https://l3xmp4s41k.execute-api.us-east-1.amazonaws.com/items' ).text )
                    def items = json.Items
                    def tags = []
                    items.each {
                       if(it.Branch==rauto_branch && it.Build=="latest"){
                       tags = it.tags
                        }
                    }
                    return tags
                '''
            ],
            script: [
                classpath: [],
                script:
                '''
                    import groovy.json.JsonSlurper
                    def json = new JsonSlurper().parseText( new URL( 'https://l3xmp4s41k.execute-api.us-east-1.amazonaws.com/items' ).text )
                    def items = json.Items
                    def tags = []
                    items.each {
                       if(it.Branch==rauto_branch && it.Build=="latest"){
                            if(squad_name=="all"){
                                tags = it.tags.all_tags
                            }
                            if(squad_name=="blue"){
                                tags = it.tags.blue_tags
                            }
                            if(squad_name=="green"){
                                tags = it.tags.green_tags
                            }
                            if(squad_name=="pelicians"){
                                tags = it.tags.pelicians_tags
                            }
                            if(squad_name=="vikings"){
                                tags = it.tags.vikings_tags
                            }
                            if(squad_name=="avengers"){
                                tags = it.tags.avengers_tags
                            }
                            if(squad_name=="alpha"){
                                tags = it.tags.alpha_tags
                            }
                            if(squad_name=="mavericks"){
                                tags = it.tags.mavericks_tags
                            }
                            if(squad_name=="labs-paas"){
                                tags = it.tags.labs_paas_tags
                            }
                            if(squad_name=="common"){
                                tags = it.tags.common_tags
                            }
                       }
                    }
                    if(tags.size()==0) {
                        items.each {
                            if(it.Branch=="master" && it.Build=="latest"){
                            tags = it.tags.all_tags
                            }
                        }
                    }
                    return tags
                '''
            ]
        ]
    ],
    [$class: 'CascadeChoiceParameter',
        choiceType: 'PT_SINGLE_SELECT',
        description: 'Select Rafay-Controller version from Jira',
        name: 'rcloud_version',
        script: [
            $class: 'GroovyScript',
            fallbackScript: [
                classpath: [],
                script:
                '''
                    return ['2.3', '2.3-Patch', '2.4', '2.4-Patch', '2.5', '2.6', '2.7', '2.8','3.1']
                '''
            ],
            script: [
                classpath: [],
                script:
                '''
                    import groovy.json.JsonSlurper
                    import java.net.URL
                    import java.net.HttpURLConnection
                    import java.util.Base64
                    import jenkins.model.Jenkins

                    def credentialsId = 'jira-api-key'
                    def credentials = com.cloudbees.plugins.credentials.CredentialsProvider.lookupCredentials(
                        com.cloudbees.plugins.credentials.common.StandardUsernameCredentials.class,
                        Jenkins.instance,
                        null,
                        null
                    )

                    def jiraCredentials = credentials.find { it.id == credentialsId }

                    if (jiraCredentials instanceof com.cloudbees.plugins.credentials.common.StandardUsernamePasswordCredentials) {
                        def username = jiraCredentials.username
                        def password = jiraCredentials.password
                         println("Jira Username: ${username}")
                         println( "Jira Password: ${password}")
                    } else {
                        error "Credentials with ID '${credentialsId}' not found or not of type Username/Password"
                    }
                    def username =jiraCredentials.username
                    def password = jiraCredentials.password
                    def authString = "${username}:${password}"
                    def encodedAuth = Base64.getEncoder().encodeToString(authString.bytes)
                    def apiUrl = 'https://rafaysystems.atlassian.net/rest/api/2/project/RC/version?maxResults=500&startAt=0'
                    def url = new URL(apiUrl)
                    def connection = url.openConnection() as HttpURLConnection
                    connection.requestMethod = 'GET'
                    connection.setRequestProperty("Authorization", "Basic ${encodedAuth}")
                    def responseCode = connection.responseCode
                    if (responseCode == HttpURLConnection.HTTP_OK) {
                        def jsonResponse = new JsonSlurper().parseText(connection.inputStream.text)
                        def versions = []
                        for (value in jsonResponse['values']) {
                            versions.add(value['name'])
                        }
                        def pattern = ~/^[234].*/
                        def filteredVersions = versions.findAll { version -> pattern.matcher(version).find() }
                        def sortedVersions = filteredVersions.sort { a, b -> b <=> a }
                        return sortedVersions
                    } else {
                        println("Error: ${responseCode} - ${connection.responseMessage}")
                    }
                    connection.disconnect()
                '''
            ]
        ]
    ],
    string(name: 'rctl_branch', defaultValue: 'r2.8.0', description: 'rctl branch used for testing'),
    string(name: 'rctl_buildnum', defaultValue: '1', description: 'rctl image build used for testing'),
    string(name: 'terraform_version', defaultValue: 'RafaySystems/rafay:1.1.34', description: "terraform build path in format 'master:34' for local binary, use 'RafaySystems/rafay:1.1.1' for terraform registry provider"),
    extendedChoice(name: 'test_type', value: 'smoke,mini-sanity,regression', defaultValue: 'regression', description: 'Select test type tag. for now its all sanity. For Tags description please refer https://rafaysystems.atlassian.net/wiki/spaces/EN/pages/106135557/Nightly+Pipeline#NightlyPipeline-Rautorunner:', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_SINGLE_SELECT', visibleItemCount: 1),
    extendedChoice(name: 'components', value: 'all,rafay_platform,rafay_infra,rafay_services,rafay_paas', defaultValue: 'all', description: 'Provide test components to run. Say rafay_platform, rafay_infra', multiSelectDelimiter: ' ', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_MULTI_SELECT', visibleItemCount: 4),
    extendedChoice(name: 'rafay_interface', value: 'rafay-apiANDrafay-cliANDrafay-terraform,rafay-api,rafay-cli,rafay-terraform', defaultValue: 'rafay-apiANDrafay-cliANDrafay-terraform', description: 'Select the interface type to run tests on [api/cli]', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_SINGLE_SELECT', visibleItemCount: 3),
    string(name: 'exclude_k8s_versions', defaultValue: 'None', description: 'k8s versions to be excluded should be given as comma separated strings[1.22,1,23]/[1.22]/[v1.22,v1.23]'),
    choice(name: 'infra_parallel', choices: "true\nfalse", description: 'Say if infra tests to run in parallel or not'),
    extendedChoice(name: 'infra_threads', value: '2,3,4,5,6,7,8,9,10', defaultValue: '5', description: 'Number of threads for running infra tests in parallel. if infra_parallel is true, this value make sense.', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_SINGLE_SELECT', visibleItemCount: 1),
    choice(name: 'platform_parallel', choices: "true\nfalse", description: 'Say if platform tests to run in parallel or not'),
    extendedChoice(name: 'platform_threads', value: '2,3,4,5,6,7,8,9,10', defaultValue: '5', description: 'Number of threads for running platform tests in parallel. if platform_parallel is true, this value make sense.', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_SINGLE_SELECT', visibleItemCount: 1),
    choice(name: 'services_parallel', choices: "true\nfalse", description: 'Say if rafay services tests to run in parallel or not'),
    extendedChoice(name: 'services_threads', value: '2,3,4,5,6,7,8,9,10', defaultValue: '5', description: 'Number of threads for running services tests in parallel. if services_parallel is true, this value make sense.', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_SINGLE_SELECT', visibleItemCount: 1),
    extendedChoice(name: 'email_address', value: email_address, defaultValue: 'automation@rafay.co,qa@rafay.co', description: 'Select Email address for automation reports', multiSelectDelimiter: ',', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_MULTI_SELECT', visibleItemCount: 10)
])
])

pipeline {
  agent {
      dockerfile {
        filename 'Dockerfile.Jenkinsfile'
        dir 'build'
        args " --name production-${env.BRANCH_NAME}-${env.BUILD_NUMBER} --privileged --hostname testbox-${env.BRANCH_NAME}-${env.BUILD_NUMBER} " +
           " -v /tmp:/tmp " +
           " -v /home/ubuntu/.ssh:/home/ubuntu/.ssh " +
           " -v /home/ubuntu/.aws:/home/ubuntu/.aws " +
           " -v /home/ubuntu/.sendgrid:/home/ubuntu/.sendgrid " +
           " -v /var/run/docker.sock:/var/run/docker.sock " +
           " -v /opt/build-storage/opt/rafay:/opt/rafay/" +
           " --user ubuntu " +
           " -e HOST_HOME=/home/ubuntu " +
           " -e RUN_ENV=production-${env.BRANCH_NAME}-${env.BUILD_NUMBER} " +
           " -e SQUAD=${params.squad_name} "
        label 'testbox'
      }
  }
  // triggers {
  //      //Scheduled to every 2 hours every day
  //      cron('0 0,8,16,23 * * 0-6')
  //  }

  stages {
    stage("Determine the Build Numbers") {
      steps {
        sh "mkdir -p workdir; find workdir -maxdepth 1 -type f -delete"
        sh 'pwd; env; docker ps'

        sh """
        echo "Future Use: When we have stage successful upgrade/downgrade versions would help us to upgrade stage"
        cat << EOF > workdir/init_version.json
        {
          "rauto-branch": "${params.rauto_branch}",
          "rauto": "${params.rauto_buildnum}",
          "rctl-branch": "${params.rctl_branch}",
          "rctl": "${params.rctl_buildnum}"
        }
        EOF
        """.stripIndent()

        sh """
        echo "User input build numbers:"
        cat workdir/init_version.json
        echo 
        make update-version-for-stage-production
        """
      }
      }
    stage("Cleanup Old Reports") {
      steps {
        sh 'echo "Delete Old rauto config and reports, so that when Pipeline fails due to some reason email will not send old reports"'
        sh 'make delete-old-rauto-reports'
      }
    }
    stage("Running Automated Tests") {
      steps {
        script{
          if ( "${params.components}" == "all" ) {
            running_components = "rafay_platform rafay_infra rafay_services rafay_paas"
            echo "Components selected : '${running_components}'"
          }
          if ( "${params.components}" != "all" ) {
            running_components = "${params.components}"
            echo "Components selected : '${running_components}'"
          }
        }

        script{
          echo "Test Types selected : '${params.test_type}'"
          echo "Features selected : '${params.features}'"
          }

        script{
             if ( "${params.features}" == "all" ) {
                if ( "${params.rafay_interface}" == "rafay-apiANDrafay-cliANDrafay-terraform" ) {
                    run_test_cases = "${params.test_type}"
                    echo "Running test cases with tags : '${run_test_cases}'"
                    }
                else {
                    run_test_cases = "${params.test_type}AND${params.rafay_interface}"
                    echo "Running test cases with tags : '${run_test_cases}'"
                    }
             }

             else {
                if ( "${params.rafay_interface}" == "rafay-apiANDrafay-cliANDrafay-terraform" ) {
                    def selected_features = "${params.features}"
                    String new_features = selected_features.replace(",", "AND${params.test_type}OR")
                    run_test_cases = "${new_features}AND${params.test_type}"
                    echo "Running test cases with tags : '${run_test_cases}'"
                }
                else {
                    def selected_features = "${params.features}"
                    if ( "${params.rafay_interface}" == "rafay-cli" ) {
                        String new_features = selected_features.replace(",", "AND${params.test_type}ANDrafay-cliOR")
                        run_test_cases = "${new_features}AND${params.test_type}ANDrafay-cli"
                        }
                    else if ( "${params.rafay_interface}" == "rafay-terraform" ) {
                        String new_features = selected_features.replace(",", "AND${params.test_type}ANDrafay-terraformOR")
                        run_test_cases = "${new_features}AND${params.test_type}ANDrafay-terraform"
                        }
                    else{
                        String new_features = selected_features.replace(",", "AND${params.test_type}ANDrafay-apiOR")
                        run_test_cases = "${new_features}AND${params.test_type}ANDrafay-api"
                        }
                    echo "Running test cases with tags : '${run_test_cases}'"
                }
             }
        }

        script{
                echo 'Running Tests on stage, hence using prod.json'
                env.test_env_file = "prod.json"
                echo "'${env.test_env_file}'"
                test_environment = "prod"
            }
        sh """
        make rauto-prep
        make INCLUDE="${run_test_cases}" COMPONENT="${running_components}" TEST_ENVIRONMENT_FILE="${env.test_env_file}" INFRA_PARALLEL="${infra_parallel}" INFRA_THREADS="${infra_threads}" PLATFORM_PARALLEL="${platform_parallel}" PLATFORM_THREADS="${platform_threads}" RAFAY_SERVICES_PARALLEL="${services_parallel}" RAFAY_SERVICES_THREADS="${services_threads}" TERRAFORM_VERSION="${terraform_version}" EXCLUDE_K8S_VERSION="${exclude_k8s_versions}" run-rauto run-rauto
        """
      }
    }
    }

  post {
    success {
        echo 'send notification to slack and email test results'
        step([$class: 'RobotPublisher', disableArchiveOutput: false, enableCache: true, logFileName: 'log.html', otherFiles: '', outputFileName: 'output.xml', outputPath: 'rauto/rauto-results/reports/', passThreshold: 95, reportFileName: 'report.html', unstableThreshold: 20.0])
    }
    failure {
        echo 'send notification to slack and email test results'
        step([$class: 'RobotPublisher', disableArchiveOutput: false, enableCache: true, logFileName: 'log.html', otherFiles: '', outputFileName: 'output.xml', outputPath: 'rauto/rauto-results/reports/', passThreshold: 95, reportFileName: 'report.html', unstableThreshold: 20.0])
    }
    always {
      sh """
      make verify-rauto-results-exists
      make send-email BRANCH_NAME="${env.BRANCH_NAME}" BUILD_NUMBER="${env.BUILD_NUMBER}" email_address="${params.email_address}" test_environment="${test_environment}" build_url="${env.BUILD_URL}" TEST_PURPOSE="${params.test_purpose}" TEST_TYPE="${params.test_type}" FEATURE_TAGS="${params.features}" SQUAD_NAME="${params.squad_name}" RCLOUD_VERSION="${params.rcloud_version}"
      make upload-reports-to-s3-bucket   JENKIN_JOB="${env.JOB_NAME}"  JENKIN_BUILD="${env.BUILD_NUMBER}"  RCLOUD_VERSION="${params.rcloud_version}" test_environment="${test_environment}"    SQUAD_NAME="${params.squad_name}"
      make sync-results  test_environment="${test_environment}" BRANCH_NAME="${params.rauto_branch}"  SQUAD_NAME="${params.squad_name}"  JENKIN_JOB_NAME="${env.JOB_NAME}"  JENKIN_BUILD_NUMBER="${env.BUILD_NUMBER}"  TEST_PURPOSE="${params.test_purpose}"  FEATURE_TAGS="${params.features}" RCLOUD_VERSION="${params.rcloud_version}"
      """
    }
  }
}
