pipeline {
    agent any
    parameters {
        string(name: 'rctl_branch',          defaultValue: '')
        string(name: 'rcloud_version',       defaultValue: '')
        string(name: 'rctl_buildnum',        defaultValue: '')
        string(name: 'squad_name',           defaultValue: '')
        string(name: 'test_type',            defaultValue: '')
        string(name: 'rafay_interface',      defaultValue: '')
        string(name: 'features',             defaultValue: '')
        string(name: 'components',           defaultValue: '')
        string(name: 'terraform_version',    defaultValue: 'None')
        booleanParam(name: 'oci_docker_agent_host', defaultValue: false)
    }
    stages {
        stage('Received Params') {
            steps {
                script {
                    echo "===== Parameters from slack-router ====="
                    params.each { k, v -> echo "${k} = ${v}" }
                    echo "========================================"
                }
            }
        }
        stage('Simulate Run') {
            steps { sh 'sleep 3 && echo "Done!"' }
        }
    }
}
