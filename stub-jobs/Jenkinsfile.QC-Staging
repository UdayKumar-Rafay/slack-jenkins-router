// Stub for QC-Staging
pipeline {
    agent any
    parameters {
        string(name: 'test_purpose',         defaultValue: 'QC Regression Run',                      description: 'Purpose of this run')
        string(name: 'rauto_branch',         defaultValue: 'master',                          description: 'rauto branch')
        string(name: 'rauto_buildnum',       defaultValue: '',                                description: 'rauto image build number')
        choice(name: 'squad_name',           choices: ['all','blue','green','pelicians','vikings','avengers','alpha','mavericks','eaas','common','labs-paas'], description: 'Squad')
        string(name: 'features',             defaultValue: '',                                description: 'Rauto tags (fetched by router)')
        string(name: 'rcloud_version',       defaultValue: '',                                description: 'Rafay controller version e.g. 4.1, 4.1-Patch')
        string(name: 'rctl_branch',          defaultValue: 'master',                          description: 'rctl branch e.g. v4.1.x')
        string(name: 'rctl_buildnum',        defaultValue: '',                                description: 'rctl image build number')
        string(name: 'terraform_version',    defaultValue: 'None',                            description: 'Terraform build e.g. RafaySystems/rafay:1.1.1 or master:34 or v4.1.x:6')
        choice(name: 'test_type',            choices: ['regression','smoke','mini-sanity'],   description: 'Test type')
        choice(name: 'components',           choices: ['all','rafay_platform','rafay_infra','rafay_services','rafay_paas'], description: 'Components')
        booleanParam(name: 'oci_docker_agent_host', defaultValue: false,                      description: 'Deploy docker agent on OCI')
        choice(name: 'rafay_interface',      choices: ['rafay-apiANDrafay-cliANDrafay-terraform','rafay-api','rafay-cli','rafay-terraform'], description: 'Interface')
        string(name: 'exclude_k8s_versions', defaultValue: 'None',                            description: 'K8s versions to exclude')
        choice(name: 'infra_parallel',       choices: ['true','false'],                       description: 'Infra parallel')
        choice(name: 'infra_threads',        choices: ['5','2','3','4','6','7','8','9','10'], description: 'Infra threads')
        choice(name: 'platform_parallel',    choices: ['true','false'],                       description: 'Platform parallel')
        choice(name: 'platform_threads',     choices: ['5','2','3','4','6','7','8','9','10'], description: 'Platform threads')
        choice(name: 'services_parallel',    choices: ['true','false'],                       description: 'Services parallel')
        choice(name: 'services_threads',     choices: ['5','2','3','4','6','7','8','9','10'], description: 'Services threads')
        string(name: 'email_address',        defaultValue: 'automation@rafay.co,qa@rafay.co', description: 'Email recipients')
        string(name: 'triggered_by',         defaultValue: '',                                description: 'Slack username who triggered this run')
        string(name: 'triggered_by_id',      defaultValue: '',                                description: 'Slack user ID of the triggerer')
    }
    stages {
        stage('Received Params') {
            steps {
                script {
                    echo "===== Parameters from slack-router ====="
                    params.each { k, v -> echo "${k} = ${v}" }
                    echo "========================================"
                }
            }
        }
        stage('Simulate Run') {
            steps { sh 'sleep 3 && echo "QC-Staging run complete!"' }
        }
    }
    post {
        always {
            script {
                // In real pipelines: read from RobotPublisher action after step([$class:'RobotPublisher',...])
                // def robotAction = currentBuild.rawBuild.getAction(hudson.plugins.robot.RobotBuildAction.class)
                // def passed = robotAction?.overallPassedCount ?: 0
                // def total  = robotAction?.overallTotalCount  ?: 0

                // Stub: simulate test counts
                def passed = 34
                def total  = 38

                build(
                    job: 'slack-notifier',
                    wait: false,
                    propagate: false,
                    parameters: [
                        string(name: 'build_result',    value: currentBuild.result ?: 'SUCCESS'),
                        string(name: 'build_url',       value: env.BUILD_URL),
                        string(name: 'build_number',    value: env.BUILD_NUMBER),
                        string(name: 'build_duration',  value: currentBuild.durationString),
                        string(name: 'squad_name',      value: params.squad_name),
                        string(name: 'environment',     value: 'QC-Staging'),
                        string(name: 'rcloud_version',  value: params.rcloud_version),
                        string(name: 'rafay_interface', value: params.rafay_interface),
                        string(name: 'test_type',       value: params.test_type),
                        string(name: 'triggered_by',    value: params.triggered_by),
                        string(name: 'triggered_by_id', value: params.triggered_by_id ?: ''),
                        string(name: 'passed_count',    value: passed.toString()),
                        string(name: 'total_count',     value: total.toString()),
                    ]
                )
            }
        }
    }
}
